<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SteamPoweredPlayer.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Builds synthetic .pb fixtures only; Core reads the wire format itself (byte-exact round trips). -->
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Core\SteamPoweredPlayer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Player page's pure helpers (no XAML): timecode and timeline zoom maths (plan 2026-11-07 F2-F4). -->
    <Compile Include="..\src\Views\Player\FrameTimecode.cs" Link="Player\Linked\FrameTimecode.cs" />
    <Compile Include="..\src\Views\Player\TimelineView.cs" Link="Player\Linked\TimelineView.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="fixtures\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="fixtures" />
  </ItemGroup>
</Project>
