<!-- Shell layout (Mica, 52 px title bar, BusyLine, toasts) follows FastEncoder's MainWindow.xaml (MIT). -->
<Window
    x:Class="SteamPoweredPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SteamPoweredPlayer">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" IsTabStop="True" FocusVisualPrimaryThickness="0" FocusVisualSecondaryThickness="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================================================================ title bar -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- the draggable part: logo + name + tagline + the empty space after them -->
            <Grid x:Name="DragArea" Grid.ColumnSpan="2" Background="Transparent" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="Assets/logo.png" Width="20" Height="20" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="SteamPoweredPlayer" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="·  your Steam recordings, without Steam" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <SelectorBar x:Name="Nav" Grid.Column="2" VerticalAlignment="Center" SelectionChanged="Nav_SelectionChanged">
                <SelectorBarItem x:Name="NavLibrary" AutomationProperties.AutomationId="NavLibrary" Text="Library" Tag="library">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE8F1;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="NavDownloads" AutomationProperties.AutomationId="NavDownloads" Text="Downloads" Tag="downloads">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE896;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="NavSettings" AutomationProperties.AutomationId="NavSettings" Text="Settings" Tag="settings">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE713;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>

            <StackPanel x:Name="TitleChips" AutomationProperties.AutomationId="TitleChips" Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection><EntranceThemeTransition FromHorizontalOffset="24" IsStaggeringEnabled="True" /></TransitionCollection>
                </StackPanel.ChildrenTransitions>
            </StackPanel>

            <!-- shimmering line while scanning / loading -->
            <Rectangle x:Name="BusyLine" Grid.ColumnSpan="4" Height="2" VerticalAlignment="Bottom" Margin="-16,0,0,0"
                       Fill="{StaticResource BrandGradient}" Opacity="0">
                <Rectangle.OpacityTransition><ScalarTransition /></Rectangle.OpacityTransition>
            </Rectangle>
        </Grid>

        <!-- ================================================================ pages -->
        <Frame x:Name="ContentFrame" Grid.Row="1" IsNavigationStackEnabled="True" />

        <!-- ================================================================ toasts (F6: bottom-left, never over the player) -->
        <StackPanel x:Name="ToastHost" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Margin="16,0,0,16" Spacing="8" Width="400">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="40" />
                    <AddDeleteThemeTransition />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
        </StackPanel>
    </Grid>
</Window>
