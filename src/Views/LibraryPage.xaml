<Page
    x:Class="SteamPoweredPlayer.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SteamPoweredPlayer.Views"
    NavigationCacheMode="Required">

    <Grid>
        <!-- ================================================================ first run -->
        <local:FirstRunCard x:Name="FirstRun" Visibility="Collapsed" Confirmed="FirstRun_Confirmed" />

        <!-- ================================================================ library -->
        <Grid x:Name="LibraryRoot" Padding="12,4,12,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.ChildrenTransitions>
                <TransitionCollection><EntranceThemeTransition FromVerticalOffset="40" IsStaggeringEnabled="True" /></TransitionCollection>
            </Grid.ChildrenTransitions>

            <!-- ============================================ games rail -->
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="16,14,12,8">
                        <TextBlock Text="Games" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <InfoBadge x:Name="GameCountBadge" Value="0" Style="{ThemeResource AttentionValueInfoBadgeStyle}" />
                    </StackPanel>
                    <AutoSuggestBox x:Name="SearchBox" Grid.Row="1" Margin="12,0,12,8" PlaceholderText="Search games"
                                    QueryIcon="Find" TextChanged="SearchBox_TextChanged" />

                    <ListView x:Name="GameList" AutomationProperties.AutomationId="LibraryGameList" Grid.Row="2" SelectionMode="Single" Padding="4,0,4,8"
                              SelectionChanged="GameList_SelectionChanged">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="True" />
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:GameTile">
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="52" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <Grid>
                                            <Border Style="{StaticResource ArtPlaceholder}" Visibility="{x:Bind NoCover, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind Initial, Mode=OneWay}" Visibility="{x:Bind NoCover, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Caption, Mode=OneWay}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="9" Padding="8,1,8,2" VerticalAlignment="Center"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind Count, Mode=OneWay}" Style="{StaticResource Timecode}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid x:Name="RailEmpty" Grid.Row="2" Margin="14,4,14,14" Visibility="Collapsed">
                        <local:EmptyState x:Name="RailEmptyState" Emoji="🎮" Title="No games yet" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ============================================ selected game -->
            <ScrollViewer x:Name="GameScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel Spacing="12">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection><EntranceThemeTransition FromVerticalOffset="40" IsStaggeringEnabled="True" /></TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <!-- hero -->
                    <Border Style="{StaticResource Card}" Padding="0" Height="160">
                        <Grid>
                            <Border Style="{StaticResource ArtPlaceholder}" />
                            <Image x:Name="HeroImage" Stretch="UniformToFill" />
                            <Rectangle Fill="{StaticResource HeroScrim}" />
                            <Grid Padding="24,18" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Bottom" Spacing="6">
                                    <Image x:Name="LogoImage" MaxHeight="64" MaxWidth="360" HorizontalAlignment="Left" Stretch="Uniform" Visibility="Collapsed" />
                                    <TextBlock x:Name="GameTitle" Style="{StaticResource TitleLargeTextBlockStyle}" Foreground="{StaticResource OnHeroBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="GameSubtitle" Foreground="{StaticResource OnHeroDimBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Top" Orientation="Horizontal" Spacing="6">
                                    <Border Style="{StaticResource Pill}"><TextBlock x:Name="HeroClips" Foreground="White" FontSize="12" /></Border>
                                    <Border Style="{StaticResource Pill}"><TextBlock x:Name="HeroSize" Foreground="White" FontSize="12" /></Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- cache strip -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CACHE" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <TextBlock x:Name="CacheCaption" Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Text="temporary · Steam keeps the last 2 h" />
                                <StackPanel x:Name="LiveBadge" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Ellipse x:Name="LiveDot" Width="9" Height="9" Fill="{StaticResource LiveBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="recording now" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="CacheHost" SizeChanged="CacheHost_SizeChanged">
                                <Canvas x:Name="StripCanvas" Height="84" />
                                <local:EmptyState x:Name="CacheEmpty" Emoji="⏺️" Title="No cache sessions" Visibility="Collapsed"
                                                  Message="When Steam records this game in the background, the last stretch shows up here." />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button x:Name="ReplayButton" IsEnabled="False" Click="Replay_Click" ToolTipService.ToolTip="Replay the cache: the session recording now, else the newest one">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                                        <TextBlock Text="Replay" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SaveClipButton" IsEnabled="False" ToolTipService.ToolTip="Save the last moments as a clip (arrives with editing)">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8C6;" FontSize="14" />
                                        <TextBlock Text="Save clip" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- clips -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="CLIPS" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="ClipCount" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                </StackPanel>
                                <SelectorBar x:Name="ClipFilter" Grid.Column="1" SelectionChanged="ClipFilter_SelectionChanged">
                                    <SelectorBarItem Text="All" Tag="all" IsSelected="True" />
                                    <SelectorBarItem Text="Saved" Tag="saved" />
                                    <SelectorBarItem Text="Downloaded" Tag="downloaded" />
                                    <SelectorBarItem Text="★" Tag="starred" />
                                </SelectorBar>
                                <ComboBox x:Name="SortBox" Grid.Column="2" SelectedIndex="0" MinWidth="150" SelectionChanged="SortBox_SelectionChanged"
                                          ToolTipService.ToolTip="Sort clips">
                                    <ComboBoxItem Content="Newest first" />
                                    <ComboBoxItem Content="Oldest first" />
                                    <ComboBoxItem Content="Longest first" />
                                    <ComboBoxItem Content="Most events" />
                                </ComboBox>
                            </Grid>

                            <ItemsRepeater x:Name="ClipRepeater">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="216" MinItemHeight="190" MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="local:ClipTile">
                                        <Button Tag="{x:Bind}" AutomationProperties.AutomationId="LibraryClipTile" Click="Clip_Click" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Background="Transparent" BorderThickness="0" CornerRadius="8"
                                                PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited">
                                            <StackPanel Spacing="6">
                                                <Border CornerRadius="8" Height="122" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                    <Grid>
                                                        <Border Style="{StaticResource ArtPlaceholder}" Visibility="{x:Bind NoThumb, Mode=OneWay}" />
                                                        <FontIcon Glyph="&#xE768;" FontSize="30" Foreground="#CCFFFFFF" Visibility="{x:Bind NoThumb, Mode=OneWay}" />
                                                        <Image Source="{x:Bind Thumb, Mode=OneWay}" Stretch="UniformToFill" />
                                                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                                                            <TextBlock Text="{x:Bind Length}" Style="{StaticResource Timecode}" Foreground="White" />
                                                        </Border>
                                                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                                                Visibility="{x:Bind HasMarkers}">
                                                            <TextBlock Text="{x:Bind Markers}" FontSize="12" Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Spacing="1" Padding="2,0,2,2">
                                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <FontIcon Glyph="{x:Bind KindGlyph}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind Meta}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <local:EmptyState x:Name="ClipsEmpty" Visibility="Collapsed" Emoji="🎬" Title="No clips here" />
                        </StackPanel>
                    </Border>

                    <!-- recordings + exports -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="RECORDINGS" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <local:EmptyState Emoji="📼" Title="No full recordings"
                                                  Message="Long recordings that Steam saves for this game will be listed here." />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="EXPORTS" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <local:EmptyState Emoji="📦" Title="Nothing exported yet"
                                                  Message="Cuts you export from a clip or the cache will appear here." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- shown instead of the right column when there is no library at all -->
            <Border x:Name="NoLibrary" Grid.Column="1" Style="{StaticResource Card}" Visibility="Collapsed">
                <local:EmptyState x:Name="NoLibraryState" Emoji="🗃️" Title="No library yet" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</Page>
