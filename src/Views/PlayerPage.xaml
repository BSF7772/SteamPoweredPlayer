<!-- Placeholder: another task fills in the player (libmpv renderer, markers lane, transport). -->
<Page
    x:Class="SteamPoweredPlayer.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="12,4,12,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Style="{StaticResource IconButton}" Click="Back_Click" ToolTipService.ToolTip="Back to the library">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <TextBlock x:Name="KeyText" Style="{StaticResource Timecode}" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Background="Black">
            <SwapChainPanel x:Name="VideoPanel" />
        </Border>

        <!-- transport bar (empty for now) -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Height="72">
            <TextBlock Text="Transport controls arrive with the player." Style="{StaticResource Caption}"
                       VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>
    </Grid>
</Page>
