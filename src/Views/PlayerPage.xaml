<!-- Player page (playlist | video, timeline, transport | events, export): FastEncoder's three columns 310 | * | 392 (MIT design), video on a SwapChainPanel bound to the libmpv D3D11 renderer. -->
<Page
    x:Class="SteamPoweredPlayer.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:SteamPoweredPlayer.Views.Player"
    xmlns:local="using:SteamPoweredPlayer.Views"
    PreviewKeyDown="Page_PreviewKeyDown">

    <Grid x:Name="PageRoot" Padding="12,4,12,12" ColumnSpacing="12" Background="Transparent" PointerMoved="PageRoot_PointerMoved" SizeChanged="PageRoot_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftCol" Width="310" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="RightCol" Width="392" />
        </Grid.ColumnDefinitions>
        <Grid.ChildrenTransitions>
            <TransitionCollection><EntranceThemeTransition FromVerticalOffset="40" IsStaggeringEnabled="True" /></TransitionCollection>
        </Grid.ChildrenTransitions>

        <!-- ============================================ playlist (F5): the game's recordings, the current one highlighted -->
        <Border x:Name="LeftCard" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="12,12,12,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButton}" AutomationProperties.AutomationId="PlayerBack" Click="Back_Click" ToolTipService.ToolTip="Back to the library" IsTabStop="False">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Playlist" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="GameText" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <ListView x:Name="PlaylistList" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True" Padding="4,0,4,8"
                          AutomationProperties.AutomationId="PlayerPlaylist" ItemClick="Playlist_ItemClick" IsTabStop="False">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="p:PlaylistRow">
                            <Grid Padding="0,6" ColumnSpacing="10" AutomationProperties.AutomationId="PlayerPlaylistItem"
                                  AutomationProperties.Name="{x:Bind Title}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="78" Height="44" CornerRadius="6">
                                    <Border Style="{StaticResource ArtPlaceholder}" />
                                    <TextBlock Text="{x:Bind Glyph}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{x:Bind Thumb, Mode=OneWay}" Stretch="UniformToFill" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="150" Style="{StaticResource BodyTextBlockStyle}" />
                                        <Border Style="{StaticResource Pill}" Background="{StaticResource LiveBrush}" Visibility="{x:Bind Live}" VerticalAlignment="Center">
                                            <TextBlock Text="LIVE" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Meta}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="PlaylistEmpty" Grid.Row="1" Text="No recordings of this game." Style="{StaticResource Caption}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- ============================================ video + timeline + transport -->
        <Border x:Name="CenterCard" Grid.Column="1" Style="{StaticResource Card}" Padding="12">
            <Grid x:Name="CenterGrid" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="VideoHost" CornerRadius="8" Background="#FF0B0B10" Tapped="Video_Tapped" DoubleTapped="Video_DoubleTapped">
                    <Grid x:Name="VideoLayer">
                        <SwapChainPanel x:Name="VideoPanel" SizeChanged="VideoPanel_SizeChanged" CompositionScaleChanged="VideoPanel_ScaleChanged" />

                        <!-- opening / error / unavailable -->
                        <StackPanel x:Name="StatusPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" IsHitTestVisible="False">
                            <ProgressRing x:Name="Ring" IsActive="False" Width="40" Height="40" HorizontalAlignment="Center" />
                            <FontIcon x:Name="StatusIcon" Glyph="&#xE714;" FontSize="44" Foreground="#55FFFFFF" HorizontalAlignment="Center" Visibility="Collapsed" />
                            <TextBlock x:Name="StatusText" Foreground="#CCFFFFFF" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                            <TextBlock x:Name="StatusHint" Style="{StaticResource Caption}" Foreground="#77FFFFFF" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                        </StackPanel>

                        <!-- live pill -->
                        <Border x:Name="LivePill" Style="{StaticResource Pill}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                                Padding="10,5" CornerRadius="12" Visibility="Collapsed" Tapped="LivePill_Tapped">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse x:Name="LiveDot" Width="9" Height="9" Fill="{StaticResource LiveBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="LiveText" Text="live" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- big play / pause pulse -->
                        <Border x:Name="PlayPulse" Width="72" Height="72" CornerRadius="36" Background="#88000000"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                            <FontIcon x:Name="PlayPulseIcon" Glyph="&#xE768;" FontSize="28" Foreground="White" />
                        </Border>

                        <!-- hidden debug overlay (Ctrl+Shift+D) -->
                        <Border x:Name="DebugCard" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                                CornerRadius="8" Background="#CC000000" Padding="10,8" IsHitTestVisible="False">
                            <TextBlock x:Name="DebugText" Style="{StaticResource Timecode}" Foreground="#E6FFFFFF" FontSize="11" />
                        </Border>
                    </Grid>
                </Border>

                <!-- timeline + transport (an overlay with a scrim in fullscreen) -->
                <StackPanel x:Name="Lower" AutomationProperties.AutomationId="PlayerLower" Grid.Row="1" Spacing="8">
                    <StackPanel.OpacityTransition><ScalarTransition /></StackPanel.OpacityTransition>
                    <p:TimelineControl x:Name="Timeline" />

                    <Grid x:Name="Transport" ColumnSpacing="6" RowSpacing="6" SizeChanged="Transport_SizeChanged">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PlayButton" AutomationProperties.AutomationId="PlayerPlayPause" Style="{StaticResource AccentButtonStyle}" Width="44" Height="36" Padding="0" CornerRadius="18"
                                Click="PlayPause_Click" ToolTipService.ToolTip="Play / pause (Space)" IsTabStop="False">
                            <FontIcon x:Name="PlayGlyph" Glyph="&#xE768;" FontSize="14" />
                        </Button>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="6,0,0,0">
                            <Button Style="{StaticResource IconButton}" AutomationProperties.AutomationId="PlayerBack5" Click="Back5_Click" ToolTipService.ToolTip="Back 5 s (J, Left)" IsTabStop="False">
                                <TextBlock Text="&#x2212;5" Style="{StaticResource Timecode}" FontSize="13" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" AutomationProperties.AutomationId="PlayerFrameBack" Click="FrameBack_Click" ToolTipService.ToolTip="Previous frame (,)" IsTabStop="False">
                                <FontIcon Glyph="&#xE76B;" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" AutomationProperties.AutomationId="PlayerFrameForward" Click="FrameFwd_Click" ToolTipService.ToolTip="Next frame (.)" IsTabStop="False">
                                <FontIcon Glyph="&#xE76C;" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" AutomationProperties.AutomationId="PlayerForward5" Click="Fwd5_Click" ToolTipService.ToolTip="Forward 5 s (L, Right)" IsTabStop="False">
                                <TextBlock Text="+5" Style="{StaticResource Timecode}" FontSize="13" />
                            </Button>
                            <StackPanel x:Name="TimeStack" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock x:Name="TimeText" AutomationProperties.AutomationId="PlayerTimecode" Text="00:00:00.01 / 00:00:00.00" Style="{StaticResource Timecode}" FontSize="13" />
                                <TextBlock x:Name="LoopText" Text="" Style="{StaticResource Caption}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="TransportRight" Grid.Column="3" Orientation="Horizontal" Spacing="4">
                            <ToggleButton x:Name="LoopButton" AutomationProperties.AutomationId="PlayerAbLoop" Padding="8,6" Click="Loop_Click" ToolTipService.ToolTip="A–B loop: A, B, clear (A / B keys)" IsTabStop="False">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8EE;" FontSize="13" />
                                    <TextBlock x:Name="LoopLabel" Text="A–B" FontSize="12" />
                                </StackPanel>
                            </ToggleButton>
                            <Button x:Name="SpeedButton" AutomationProperties.AutomationId="PlayerSpeed" Style="{StaticResource IconButton}" ToolTipService.ToolTip="Speed ([ and ])" IsTabStop="False">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="SpeedIcon" Glyph="&#xEC4A;" FontSize="13" />
                                    <TextBlock x:Name="SpeedText" Text="1×" Style="{StaticResource Timecode}" FontSize="13" MinWidth="30" />
                                </StackPanel>
                                <Button.Flyout><MenuFlyout x:Name="SpeedMenu" Placement="TopEdgeAlignedRight" /></Button.Flyout>
                            </Button>
                            <ToggleButton x:Name="MuteButton" AutomationProperties.AutomationId="PlayerMute" Padding="8,6" Click="Mute_Click" ToolTipService.ToolTip="Mute (M)" IsTabStop="False">
                                <FontIcon x:Name="MuteGlyph" Glyph="&#xE767;" FontSize="14" />
                            </ToggleButton>
                            <!-- narrow widths: the slider moves into this button's flyout (PlayerPage.xaml.cs, ApplyTransportTier) -->
                            <Button x:Name="VolumeFlyoutButton" AutomationProperties.AutomationId="PlayerVolumeButton" Style="{StaticResource IconButton}" Width="28" Padding="0"
                                    Visibility="Collapsed" ToolTipService.ToolTip="Volume" IsTabStop="False">
                                <FontIcon Glyph="&#xE70D;" FontSize="10" />
                            </Button>
                            <Slider x:Name="VolumeSlider" AutomationProperties.AutomationId="PlayerVolume" Width="92" Minimum="0" Maximum="100" Value="100" StepFrequency="1" VerticalAlignment="Center"
                                    IsThumbToolTipEnabled="False" ValueChanged="Volume_ValueChanged" IsTabStop="False" />
                            <Button x:Name="FullscreenButton" AutomationProperties.AutomationId="PlayerFullscreen" Style="{StaticResource IconButton}" Click="Fullscreen_Click" ToolTipService.ToolTip="Fullscreen (F)" IsTabStop="False">
                                <FontIcon x:Name="FullscreenGlyph" Glyph="&#xE740;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================ events + export -->
        <Grid x:Name="RightPanel" Grid.Column="2" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="16,14,12,6">
                        <TextBlock Text="Events" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <InfoBadge x:Name="EventBadge" Value="0" Style="{ThemeResource AttentionValueInfoBadgeStyle}" Visibility="Collapsed" />
                        <TextBlock Text="N next · P previous" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsRepeater x:Name="FilterChips" Grid.Row="1" Margin="12,0,12,8">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="112" MinItemHeight="32" MinRowSpacing="6" MinColumnSpacing="6" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>

                    <ListView x:Name="EventsList" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True" Padding="4,0,4,8"
                              ItemClick="Event_ItemClick" IsTabStop="False">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="True" />
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="p:EventRow">
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="18" Background="{x:Bind Accent}" BorderBrush="{x:Bind Stroke}" BorderThickness="1">
                                        <TextBlock Text="{x:Bind Glyph}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Time}" Style="{StaticResource Timecode}" VerticalAlignment="Center"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EventsEmpty" Grid.Row="2" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Top"
                               Margin="24,28,24,0" TextAlignment="Center" TextWrapping="Wrap" Text="No timeline events for this recording." />
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12">
                <StackPanel Spacing="10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE898;" FontSize="14" />
                            <TextBlock Text="Export" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                        <HyperlinkButton x:Name="ExportFolderButton" AutomationProperties.AutomationId="PlayerExportFolder" HorizontalAlignment="Right" Padding="4,0" FontSize="12"
                                         Content="Folder…" Click="ExportFolder_Click" IsTabStop="False" />
                    </Grid>
                    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" IsTabStop="False">
                        <StackPanel Spacing="8" Padding="0,0,12,0">
                            <ComboBox x:Name="ExportPresetBox" AutomationProperties.AutomationId="PlayerExportPreset" HorizontalAlignment="Stretch" IsTabStop="False"
                                      SelectionChanged="ExportPreset_SelectionChanged" />
                            <NumberBox x:Name="TargetSizeBox" AutomationProperties.AutomationId="PlayerExportTargetMb" Header="Target size (MB)" Value="10" Minimum="1" Maximum="100000"
                                       SpinButtonPlacementMode="Compact" Visibility="Collapsed" ValueChanged="TargetSize_ValueChanged" />

                            <Expander Header="Cuts" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsTabStop="False">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="Set A and B, then keep that part. Only kept parts are exported." />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="KeepAbButton" AutomationProperties.AutomationId="PlayerKeepAb" Content="Keep A–B" Click="KeepAb_Click" IsTabStop="False" />
                                        <Button x:Name="HighlightsButton" AutomationProperties.AutomationId="PlayerHighlights" Content="Highlights" Click="Highlights_Click" IsTabStop="False"
                                                ToolTipService.ToolTip="Keep 5 s before and 3 s after each marker" />
                                        <Button x:Name="ClearKeptButton" Content="Clear" Click="ClearKept_Click" IsTabStop="False" Visibility="Collapsed" />
                                    </StackPanel>
                                    <ItemsControl x:Name="KeptList" IsTabStop="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:KeptSpanRow">
                                                <Grid>
                                                    <TextBlock Text="{x:Bind Text}" Style="{StaticResource Timecode}" VerticalAlignment="Center" />
                                                    <Button HorizontalAlignment="Right" Padding="6,2" Tag="{x:Bind Self}" Click="RemoveKept_Click" IsTabStop="False" ToolTipService.ToolTip="Remove">
                                                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="EditExpander" Header="Speed and sound" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsTabStop="False">
                                <StackPanel x:Name="EditPanel" Spacing="6">
                                    <ComboBox x:Name="SpeedBox" AutomationProperties.AutomationId="PlayerExportSpeed" Header="Speed" HorizontalAlignment="Stretch" IsTabStop="False"
                                              SelectionChanged="ExportOption_SelectionChanged" />
                                    <Slider x:Name="VolumeEditSlider" AutomationProperties.AutomationId="PlayerExportVolume" Header="Volume" Minimum="0" Maximum="200" Value="100" StepFrequency="5"
                                            ValueChanged="VolumeEdit_ValueChanged" IsTabStop="False" />
                                    <ToggleSwitch x:Name="MuteEditToggle" AutomationProperties.AutomationId="PlayerExportMute" OnContent="No sound" OffContent="Keep sound" Toggled="ExportOption_Changed" IsTabStop="False" />
                                    <ToggleSwitch x:Name="FixDriftToggle" AutomationProperties.AutomationId="PlayerExportFixDrift" OnContent="Fix timing drift" OffContent="Keep original timing" IsOn="True"
                                                  Toggled="ExportOption_Changed" IsTabStop="False" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Audio sync" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsTabStop="False">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="AudioDelayText" AutomationProperties.AutomationId="PlayerAudioDelay" Style="{StaticResource Timecode}" Text="Audio delay 0 ms" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="−20 ms" Click="NudgeEarlier_Click" IsTabStop="False" ToolTipService.ToolTip="Sound earlier" />
                                        <Button Content="+20 ms" Click="NudgeLater_Click" IsTabStop="False" ToolTipService.ToolTip="Sound later" />
                                        <Button Content="Reset" Click="NudgeReset_Click" IsTabStop="False" />
                                        <Button x:Name="DetectButton" AutomationProperties.AutomationId="PlayerDetectSync" Content="Detect" Click="Detect_Click" IsTabStop="False" />
                                    </StackPanel>
                                    <TextBlock x:Name="SyncStatusText" AutomationProperties.AutomationId="PlayerSyncStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    <ToggleSwitch x:Name="ApplyToGameToggle" AutomationProperties.AutomationId="PlayerApplySyncToGame" OnContent="Applied to this game" OffContent="Apply to this game" Toggled="ApplyToGame_Toggled" IsTabStop="False" />
                                </StackPanel>
                            </Expander>

                            <ToggleSwitch x:Name="ChaptersToggle" AutomationProperties.AutomationId="PlayerExportChapters" OnContent="Markers as chapters" OffContent="No chapters" IsOn="True" IsTabStop="False" />
                            <Grid>
                                <Button x:Name="EstimateButton" AutomationProperties.AutomationId="PlayerEstimate" Content="Estimate size" Click="Estimate_Click" IsTabStop="False" />
                                <TextBlock x:Name="EstimateText" AutomationProperties.AutomationId="PlayerEstimateText" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock x:Name="ExportRangeText" AutomationProperties.AutomationId="PlayerExportRange" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    <ProgressBar x:Name="ExportProgressBar" Maximum="1" Visibility="Collapsed" />
                    <Grid x:Name="ExportQueueRow" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ExportQueueText" AutomationProperties.AutomationId="PlayerExportQueue" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                        <Button x:Name="CancelExportButton" Grid.Column="1" AutomationProperties.AutomationId="PlayerExportCancel" Content="Cancel" Click="CancelExport_Click" IsTabStop="False" Visibility="Collapsed" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ExportButton" AutomationProperties.AutomationId="PlayerExport" HorizontalAlignment="Stretch" IsTabStop="False" Click="Export_Click"
                                Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8C6;" FontSize="13" />
                                <TextBlock Text="Export" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SaveClipButton" Grid.Column="1" AutomationProperties.AutomationId="PlayerSaveClip" Content="Save clip" HorizontalAlignment="Stretch" IsTabStop="False" Click="SaveClip_Click"
                                ToolTipService.ToolTip="Lossless, with markers as chapters" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ScreenshotButton" AutomationProperties.AutomationId="PlayerScreenshot" Content="Screenshot" HorizontalAlignment="Stretch" IsTabStop="False" Click="Screenshot_Click"
                                ToolTipService.ToolTip="Save this frame to the export folder (S)" />
                        <Button x:Name="OpenFastEncoderButton" Grid.Column="1" AutomationProperties.AutomationId="PlayerOpenFastEncoder" Content="Open in FastEncoder" HorizontalAlignment="Stretch" IsTabStop="False"
                                Click="OpenFastEncoder_Click" Visibility="Collapsed" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
