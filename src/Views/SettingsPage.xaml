<Page
    x:Class="SteamPoweredPlayer.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="12,4,12,12" Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection><EntranceThemeTransition FromVerticalOffset="40" IsStaggeringEnabled="True" /></TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Decoding" Style="{StaticResource SectionTitle}" />
                    <RadioButtons x:Name="DecodeButtons" SelectionChanged="Decode_Changed">
                        <RadioButton Content="GPU (auto)" Tag="gpu" />
                        <RadioButton Content="CPU" Tag="cpu" />
                    </RadioButtons>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="GPU decoding is the default and falls back to the CPU by itself. Choose CPU if video looks wrong on this PC." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Library folder" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="DataFolderText" FontFamily="Cascadia Mono, Consolas" FontSize="13" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <TextBlock Text="Index, artwork and thumbnails. Never inside Steam's recording folder." Style="{StaticResource Caption}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Recordings folder (from Steam)" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="RecordingsText" FontFamily="Cascadia Mono, Consolas" FontSize="13" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <TextBlock x:Name="KeepText" Style="{StaticResource Caption}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
