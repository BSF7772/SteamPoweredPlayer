<Page
    x:Class="SteamPoweredPlayer.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="12,4,12,12" Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection><EntranceThemeTransition FromVerticalOffset="40" IsStaggeringEnabled="True" /></TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Decoding" Style="{StaticResource SectionTitle}" />
                    <RadioButtons x:Name="DecodeButtons" SelectionChanged="Decode_Changed">
                        <RadioButton x:Name="GpuOption" Content="GPU (auto)" Tag="gpu" />
                        <RadioButton Content="CPU" Tag="cpu" />
                    </RadioButtons>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="GPU decoding is the default and falls back to the CPU by itself. Choose CPU if video looks wrong on this PC. The choice applies the next time a recording opens or thumbnails are made." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Library folder" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="DataFolderText" FontFamily="Cascadia Mono, Consolas" FontSize="13" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <TextBlock Text="Index, artwork and thumbnails. Never inside Steam's recording folder." Style="{StaticResource Caption}" />
                    <InfoBar x:Name="DataProblem" IsOpen="False" IsClosable="False" Severity="Warning" Title="Can't use this folder" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button x:Name="ChangeDataButton" Click="ChangeData_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock Text="Change…" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenDataButton" Click="OpenData_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE838;" FontSize="14" />
                                <TextBlock Text="Open in Explorer" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Recordings folder (from Steam)" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="RecordingsText" FontFamily="Cascadia Mono, Consolas" FontSize="13" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <TextBlock x:Name="KeepText" Style="{StaticResource Caption}" />
                    <TextBlock Text="Read from Steam's own settings. SteamPoweredPlayer only reads here and never writes." Style="{StaticResource Caption}" />
                    <Button x:Name="OpenRecordingsButton" Click="OpenRecordings_Click" Margin="0,4,0,0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE838;" FontSize="14" />
                            <TextBlock Text="Open in Explorer" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="PhoneCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock Text="Phone app" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Builds the Android app and installs it on the phone plugged in by USB, then starts it. Its saved servers stay. You can unplug the phone when it's done. The phone needs USB debugging on (Developer options)." />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button x:Name="DeployPhoneButton" AutomationProperties.AutomationId="SettingsDeployPhone" Click="DeployPhone_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8EA;" FontSize="14" />
                                <TextBlock Text="Install on phone" />
                            </StackPanel>
                        </Button>
                        <ProgressRing x:Name="DeployRing" IsActive="False" Width="20" Height="20" />
                    </StackPanel>
                    <TextBlock x:Name="DeployStatus" AutomationProperties.AutomationId="SettingsDeployStatus" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
