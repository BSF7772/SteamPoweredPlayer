<Page
    x:Class="SteamPoweredPlayer.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SteamPoweredPlayer.Views"
    Background="Transparent">
    <Grid Padding="24,12,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <StackPanel Spacing="10">
                <TextBlock Text="Network library" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="Point at another PC's recording folder. Recordings are downloaded first, then play from this PC, so a bad connection can't interrupt them. The remote folder is only ever read." />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="LibraryBox" AutomationProperties.AutomationId="DownloadsLibrary" HorizontalAlignment="Stretch" PlaceholderText="No network library yet"
                              SelectionChanged="LibraryBox_SelectionChanged" />
                    <Button Grid.Column="1" AutomationProperties.AutomationId="DownloadsAdd" Content="Add folder…" Click="Add_Click" />
                    <Button x:Name="RefreshButton" Grid.Column="2" AutomationProperties.AutomationId="DownloadsRefresh" Content="Refresh" Click="Refresh_Click" />
                    <Button x:Name="RemoveButton" Grid.Column="3" AutomationProperties.AutomationId="DownloadsRemove" Content="Remove" Click="Remove_Click"
                            ToolTipService.ToolTip="Forget this library. Downloaded chunks stay in the cache." />
                </Grid>
                <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="DownloadsStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                <InfoBar x:Name="MeteredBar" IsOpen="False" IsClosable="True" Severity="Informational" Title="This network is metered"
                         AutomationProperties.AutomationId="DownloadsMetered"
                         Message="Downloads use data from your plan. The app shows how much it has fetched, and nothing else changes.">
                    <InfoBar.ActionButton>
                        <Button Content="Don't show again" Click="DontShowMetered_Click" AutomationProperties.AutomationId="DownloadsMeteredHide" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <ListView x:Name="RecordingList" AutomationProperties.AutomationId="DownloadsList" SelectionMode="None">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:DownloadRow">
                            <Grid Padding="0,8" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Maximum="1" Value="{x:Bind Fraction, Mode=OneWay}" Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" />
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Center" Content="{x:Bind ActionText, Mode=OneWay}" Tag="{x:Bind Self}" Click="Action_Click"
                                        AutomationProperties.AutomationId="DownloadsAction" />
                                <Button Grid.Column="2" VerticalAlignment="Center" Content="Around markers" Tag="{x:Bind Self}" Click="Around_Click" IsEnabled="{x:Bind CanAround, Mode=OneWay}"
                                        AutomationProperties.AutomationId="DownloadsAround" ToolTipService.ToolTip="{x:Bind AroundTooltip, Mode=OneWay}" />
                                <Button Grid.Column="3" VerticalAlignment="Center" Content="Play" Tag="{x:Bind Self}" Click="Play_Click" IsEnabled="{x:Bind CanPlay, Mode=OneWay}"
                                        AutomationProperties.AutomationId="DownloadsPlay" />
                                <ToggleButton Grid.Column="4" VerticalAlignment="Center" Content="Keep offline" Tag="{x:Bind Self}" Click="Keep_Click" IsChecked="{x:Bind Pinned, Mode=OneWay}"
                                              AutomationProperties.AutomationId="DownloadsKeep" ToolTipService.ToolTip="Never evict this recording from the cache" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Text="Add a network library to see its recordings here." />
            </Grid>
        </Border>
    </Grid>
</Page>
