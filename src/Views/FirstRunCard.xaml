<UserControl
    x:Class="SteamPoweredPlayer.Views.FirstRunCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Padding="32,28" Width="660" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection><EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="True" /></TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <TextBlock Text="🗂️" FontSize="44" HorizontalAlignment="Center" />
            <TextBlock Text="Where should SteamPoweredPlayer keep its library?" Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="Intro" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="540"
                       Text="It holds the game list, artwork and thumbnails, so your recordings open fast. Your recordings themselves are never touched, and nothing is written inside Steam's folders." />

            <!-- shown only when Steam's recording folder can't be read -->
            <InfoBar x:Name="NoRecordings" IsOpen="False" IsClosable="False" Severity="Warning"
                     Title="Steam's recording folder wasn't found"
                     Message="Steam may not be installed, or Game Recording is off. Choose the folder where Steam stores its recordings." >
                <InfoBar.ActionButton>
                    <Button Content="Choose recordings folder" Click="ChooseRecordings_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Border CornerRadius="8" Padding="14,10" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="2">
                    <TextBlock Text="Proposed folder" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="PathText" FontFamily="Cascadia Mono, Consolas" FontSize="13" IsTextSelectionEnabled="True"
                               TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <InfoBar x:Name="Problem" IsOpen="False" IsClosable="False" Severity="Error" />

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Button x:Name="ConfirmButton" Style="{StaticResource AccentButtonStyle}" Click="Confirm_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" />
                        <TextBlock Text="Use this folder" />
                    </StackPanel>
                </Button>
                <Button Click="Choose_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="Choose another folder…" />
                    </StackPanel>
                </Button>
                <Button Content="Why here?">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <TextBlock MaxWidth="340" TextWrapping="Wrap"
                                       Text="The folder sits next to Steam's recordings, so a phone or another PC that reaches your recordings over a share finds the library at the same place. It must be outside Steam's recording folder, because Steam trims that folder on its own." />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
