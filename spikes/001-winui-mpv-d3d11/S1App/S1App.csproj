<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: GPL-3.0-or-later -->
  <!-- Spike S1: WinUI 3 (unpackaged, self-contained) + libmpv D3D11 render API into a SwapChainPanel. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>S1App</RootNamespace>
    <AssemblyName>S1App</AssemblyName>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- pinned portable libmpv dev build (see README); override with -p:MpvDir=... -->
    <MpvDir Condition="'$(MpvDir)' == ''">$(MSBuildThisFileDirectory)../../../../../.tools/s1/mpv-dev/</MpvDir>
    <S2Dir>$(MSBuildThisFileDirectory)../../002-edl-mp4dash-cli/S2Tool/</S2Dir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <!-- spike-only: CopyFromScreen for the overlay/black-frame checks (not for Phase 2) -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- S2's scanner / lead-EDL builder, reused unchanged -->
    <Compile Include="$(S2Dir)Session.cs" Link="S2/Session.cs" />
    <Content Include="$(MpvDir)libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
